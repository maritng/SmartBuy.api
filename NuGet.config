<?xml version="1.0" encoding="utf-8"?>
<!-- El feed de Orion viaja con el repo (nuget-local/): así el build de Docker
     y cualquier clon en otra máquina restauran sin depender del feed global
     de la máquina de desarrollo. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="smartbuy-local" value="nuget-local" />
  </packageSources>
</configuration>
